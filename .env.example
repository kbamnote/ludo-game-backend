# Copy to .env — .env is gitignored and must never be committed.

# PORT is injected by most hosts. Do not hardcode it in a deployment.
PORT=3000
NODE_ENV=development

# Public base URL used when signing media links.
LUDO_PUBLIC_URL=http://localhost:3000

# HMAC key for signed media URLs. REQUIRED in any deployed environment —
# the default below is forgeable and the server warns on boot if it sees it.
#   openssl rand -hex 32
LUDO_SIGNING_KEY=dev-only-insecure-key

# Where the local storage adapter writes. Replaced by S3/R2/GCS in Phase 8.
LUDO_STORAGE_DIR=./storage/local

# Forces the stub provider to fail, for exercising error paths.
# One of: rejected_content | rate_limited | provider_unavailable | invalid_source
# LUDO_AVATAR_STUB_FAIL=rejected_content

# ── NOT YET USED ────────────────────────────────────────────────────────────
# The real AI provider key goes here when one is chosen. It must never be
# copied into the mobile app: anything in the bundle is extractable.
# LUDO_AVATAR_PROVIDER=stub
# LUDO_AVATAR_PROVIDER_KEY=

# ── Deployment notes ────────────────────────────────────────────────────────
#
# LUDO_PUBLIC_URL must be the externally reachable URL of this service, because
# signed media links and the avatar upload URL are built from it. Pointing it
# at localhost makes the client upload to itself and fail.
#
# LUDO_STORAGE_DIR writes to the container filesystem, which most hosts wipe on
# every redeploy. Fine for a smoke test, not for real avatars — Phase 8 swaps
# the local adapter for S3/R2 behind the same interface.
#
# NODE_ENV=production disables the x-user-id auth stand-in, so the avatar
# routes return 401 until the real auth module lands in Phase 5. The health
# routes and GET /v1/avatars/styles stay open.
