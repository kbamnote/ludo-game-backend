# Copy to .env — .env is gitignored and must never be committed.

PORT=3000
NODE_ENV=development

# Public base URL used when signing media links.
LUDO_PUBLIC_URL=http://localhost:3000

# HMAC key for signed media URLs. Generate a real one for any shared
# environment: openssl rand -hex 32
LUDO_SIGNING_KEY=dev-only-insecure-key

# Where the local storage adapter writes. Replaced by S3/R2/GCS in Phase 8.
LUDO_STORAGE_DIR=./storage/local

# Forces the stub provider to fail, for exercising error paths.
# One of: rejected_content | rate_limited | provider_unavailable | invalid_source
# LUDO_AVATAR_STUB_FAIL=rejected_content

# ── NOT YET USED ────────────────────────────────────────────────────────────
# The real AI provider key goes here when one is chosen. It must never be
# copied into the mobile app: anything in the bundle is extractable.
# LUDO_AVATAR_PROVIDER=stub
# LUDO_AVATAR_PROVIDER_KEY=
