{
  "name": "ludo-server",
  "version": "0.1.0",
  "private": true,
  "description": "Ludo After Dark — API, realtime game server and @ludo/engine",
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"packages/**/*.js\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.28",
    "@colyseus/schema": "^5.0.48",
    "@colyseus/ws-transport": "^0.18.5",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/throttler": "^6.4.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "colyseus": "^0.18.12",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@colyseus/testing": "^0.18.6",
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=22"
  }
}
